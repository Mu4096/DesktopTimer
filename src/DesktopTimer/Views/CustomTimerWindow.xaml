<v:AnchoredDialogWindow x:Class="DesktopTimer.Views.CustomTimerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:v="clr-namespace:DesktopTimer.Views"
        xmlns:vm="clr-namespace:DesktopTimer.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:CustomTimerViewModel}"
        Title="時間を指定して開始"
        Width="340" Height="208"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        Left="0" Top="0"
        UseLayoutRounding="True"
        Background="{StaticResource SurfaceBaseBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}"
        FontSize="13">

    <Grid Margin="20,16,20,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 時・分・秒 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBox x:Name="HoursBox" Style="{StaticResource TimeFieldBoxStyle}" Tag="HoursText"
                     Text="{Binding HoursText, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Style="{StaticResource TimeFieldUnitStyle}" Text="時間" />
            <TextBox x:Name="MinutesBox" Style="{StaticResource TimeFieldBoxStyle}" Tag="MinutesText" Margin="12,0,0,0"
                     Text="{Binding MinutesText, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Style="{StaticResource TimeFieldUnitStyle}" Text="分" />
            <TextBox x:Name="SecondsBox" Style="{StaticResource TimeFieldBoxStyle}" Tag="SecondsText" Margin="12,0,0,0"
                     Text="{Binding SecondsText, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Style="{StaticResource TimeFieldUnitStyle}" Text="秒" />
        </StackPanel>

        <!-- 操作の案内。開始できない理由があればそちらを出す -->
        <Grid Grid.Row="1" Margin="0,8,0,0" HorizontalAlignment="Center" VerticalAlignment="Top">
            <TextBlock Text="↑↓ キー・ホイールで増減" FontSize="11.5" Foreground="{StaticResource MutedTextBrush}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Hint}" Value="">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                        <Setter Property="Visibility" Value="Hidden" />
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock Text="{Binding Hint}" FontSize="11.5" Foreground="{StaticResource WarningBrush}" />
        </Grid>

        <!-- Enter で開始、Esc で閉じる -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="キャンセル" MinWidth="88" Click="CancelButton_Click" />
            <Button Style="{StaticResource PrimaryButtonStyle}" MinWidth="88" Margin="8,0,0,0" IsDefault="True"
                    Command="{Binding StartCommand}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="11"
                               VerticalAlignment="Center" Margin="0,1,6,0" />
                    <TextBlock Text="開始" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</v:AnchoredDialogWindow>
