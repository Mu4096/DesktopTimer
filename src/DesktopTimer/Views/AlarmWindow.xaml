<v:AnchoredDialogWindow x:Class="DesktopTimer.Views.AlarmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:v="clr-namespace:DesktopTimer.Views"
        xmlns:vm="clr-namespace:DesktopTimer.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:AlarmViewModel}"
        Title="時刻を指定してアラーム"
        Width="340" Height="226"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        Left="0" Top="0"
        UseLayoutRounding="True"
        Background="{StaticResource SurfaceBaseBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}"
        FontSize="13">

    <Grid Margin="20,16,20,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 時・分（24時間制） -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBox x:Name="HourBox" Style="{StaticResource TimeFieldBoxStyle}" Tag="HourText"
                     Text="{Binding HourText, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Style="{StaticResource TimeFieldUnitStyle}" Text="時" />
            <TextBox x:Name="MinuteBox" Style="{StaticResource TimeFieldBoxStyle}" Tag="MinuteText" Margin="12,0,0,0"
                     Text="{Binding MinuteText, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Style="{StaticResource TimeFieldUnitStyle}" Text="分" />
        </StackPanel>

        <!-- 鳴る時刻の案内（開始できない理由があればそちらを出す）と、操作の案内 -->
        <StackPanel Grid.Row="1" Margin="0,8,0,0" HorizontalAlignment="Center" VerticalAlignment="Top">
            <Grid HorizontalAlignment="Center">
                <TextBlock Text="{Binding ScheduleText}" FontSize="11.5" FontWeight="SemiBold"
                           Foreground="{StaticResource AccentBrightBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Hidden" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Hint}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding Hint}" FontSize="11.5" Foreground="{StaticResource WarningBrush}" />
            </Grid>
            <TextBlock Text="↑↓ キー・ホイールで増減" FontSize="11.5" Margin="0,2,0,0" HorizontalAlignment="Center"
                       Foreground="{StaticResource MutedTextBrush}" />
        </StackPanel>

        <!-- Enter でセット、Esc で閉じる -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="キャンセル" MinWidth="88" Click="CancelButton_Click" />
            <Button Style="{StaticResource PrimaryButtonStyle}" MinWidth="88" Margin="8,0,0,0" IsDefault="True"
                    Command="{Binding StartCommand}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xEA8F;" FontFamily="{StaticResource IconFont}" FontSize="12"
                               VerticalAlignment="Center" Margin="0,1,6,0" />
                    <TextBlock Text="セット" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</v:AnchoredDialogWindow>
