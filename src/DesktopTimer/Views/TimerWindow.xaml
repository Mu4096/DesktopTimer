<Window x:Class="DesktopTimer.Views.TimerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:DesktopTimer.ViewModels"
        xmlns:v="clr-namespace:DesktopTimer.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:TimerViewModel}"
        Title="DesktopTimer"
        Width="240" Height="110"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Left="0" Top="0"
        UseLayoutRounding="True"
        FontFamily="{StaticResource UiFont}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <!-- 右クリックメニュー（ウィンドウ上のどこでも表示） -->
    <Window.ContextMenu>
        <ContextMenu>
            <!-- カウントアップの計測中は「停止」になる（結果を表示したまま止める） -->
            <MenuItem Header="{Binding CancelLabel}" Command="{Binding CancelCommand}">
                <MenuItem.Icon>
                    <TextBlock>
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="&#xE711;" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCountingUp}" Value="True">
                                        <Setter Property="Text" Value="&#xE71A;" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="タイマー（時間指定）..." Click="CustomTimerMenuItem_Click" IsEnabled="{Binding CanStartNew}">
                <MenuItem.Icon>
                    <TextBlock Text="&#xE916;" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="アラーム（時間指定）..." Click="AlarmMenuItem_Click" IsEnabled="{Binding CanStartNew}">
                <MenuItem.Icon>
                    <TextBlock Text="&#xEA8F;" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="カウントアップ開始" Command="{Binding StartCountUpCommand}">
                <MenuItem.Icon>
                    <TextBlock Text="&#xE74A;" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="設定..." Click="SettingsButton_Click">
                <MenuItem.Icon>
                    <TextBlock Text="&#xE713;" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="位置をリセット" Click="ResetPositionMenuItem_Click">
                <MenuItem.Icon>
                    <TextBlock Text="&#xE7AD;" />
                </MenuItem.Icon>
            </MenuItem>
            <!-- 再表示はトレイから（表示/非表示、ダブルクリック） -->
            <MenuItem Header="非表示にする" Click="HideMenuItem_Click">
                <MenuItem.Icon>
                    <TextBlock Text="&#xED1A;" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="終了" Click="ExitMenuItem_Click">
                <MenuItem.Icon>
                    <TextBlock Text="&#xE7E8;" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </Window.ContextMenu>

    <Grid>
        <!-- 基準サイズ 240×110 DIP で組み、拡大縮小は Viewbox に任せる（ウィンドウサイズ＝基準サイズ×スケール） -->
        <Viewbox Stretch="Uniform">
            <Border Width="240" Height="110" CornerRadius="4" BorderThickness="1"
                    Background="{StaticResource TimerCardBrush}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{StaticResource TimerCardStrokeBrush}" />
                        <Style.Triggers>
                            <!-- 残り時間が少ない時と TimeUp 中は、枠もピンクにする -->
                            <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource TimerCardWarningStrokeBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="14" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 上端の光るライン -->
                    <Rectangle Grid.Row="0" Height="1.5" Margin="36,-1,36,0" VerticalAlignment="Top" IsHitTestVisible="False">
                        <Rectangle.Style>
                            <Style TargetType="Rectangle">
                                <Setter Property="Fill" Value="{StaticResource TimerAccentLineBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource TimerAccentLineWarningBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Rectangle.Style>
                    </Rectangle>

                    <!-- グリップ。ここをドラッグした時だけウィンドウを移動する -->
                    <Border Grid.Row="0" CornerRadius="4,4,0,0" Background="Transparent"
                            Cursor="SizeAll" MouseLeftButtonDown="Grip_MouseLeftButtonDown">
                        <Grid>
                            <!-- つまめる場所であることを示す点（2段×4列） -->
                            <Path Fill="{StaticResource AccentBrush}" Opacity="0.45" Margin="11,1,0,0"
                                  HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Path.Data>
                                    <GeometryGroup>
                                        <RectangleGeometry Rect="1,1,2,2" />
                                        <RectangleGeometry Rect="5,1,2,2" />
                                        <RectangleGeometry Rect="9,1,2,2" />
                                        <RectangleGeometry Rect="13,1,2,2" />
                                        <RectangleGeometry Rect="1,5,2,2" />
                                        <RectangleGeometry Rect="5,5,2,2" />
                                        <RectangleGeometry Rect="9,5,2,2" />
                                        <RectangleGeometry Rect="13,5,2,2" />
                                    </GeometryGroup>
                                </Path.Data>
                            </Path>
                            <!-- 設定ボタン -->
                            <Button Style="{StaticResource GripIconButtonStyle}" HorizontalAlignment="Right"
                                    Content="&#xE713;" ToolTip="設定" Click="SettingsButton_Click" />
                        </Grid>
                    </Border>

                    <!-- 本体。TimeUp 中の左クリックで解除、止めたカウントアップは左クリックで閉じる。
                         Running 中は DismissCommand が無効なのでクリックでは何も起きず、
                         長押し（1秒）でキャンセル・停止する（中央にゲージを出す） -->
                    <Grid x:Name="BodyGrid" Grid.Row="1" Background="Transparent"
                          PreviewMouseLeftButtonDown="Body_PreviewMouseLeftButtonDown"
                          MouseLeftButtonUp="Body_MouseLeftButtonUp"
                          MouseMove="Body_MouseMove"
                          LostMouseCapture="Body_LostMouseCapture">
                        <Grid.InputBindings>
                            <MouseBinding Gesture="LeftClick" Command="{Binding DismissCommand}" />
                        </Grid.InputBindings>

                        <!-- Idle：プリセットボタン -->
                        <UniformGrid Columns="2" Margin="8,3,8,10"
                                     Visibility="{Binding IsIdle, Converter={StaticResource BoolToVisibility}}">
                            <Button Style="{StaticResource PresetButtonStyle}" Margin="4,0"
                                    Content="{Binding Preset1Label}" Command="{Binding StartPreset1Command}" />
                            <Button Style="{StaticResource PresetButtonStyle}" Margin="4,0"
                                    Content="{Binding Preset2Label}" Command="{Binding StartPreset2Command}" />
                        </UniformGrid>

                        <!-- Running / TimeUp / Stopped：時間（カウントダウンは残り、カウントアップは経過）・補足・進捗バー -->
                        <StackPanel VerticalAlignment="Center" Margin="0,0,0,4"
                                    Visibility="{Binding IsTimeDisplayVisible, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding TimeText}" FontFamily="{StaticResource DigitFont}"
                                       FontSize="44" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Margin="0,-8,0,-6">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <!-- 文字色はトリガーで変えるので、直接指定ではなくスタイルで設定する -->
                                        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                        <Setter Property="Effect" Value="{StaticResource TealGlowEffect}" />
                                        <Style.Triggers>
                                            <!-- 残り時間が少ない時と TimeUp 中は警告色 -->
                                            <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                                <Setter Property="Effect" Value="{StaticResource PinkGlowEffect}" />
                                            </DataTrigger>
                                            <!-- TimeUp 中は 0.5 秒ごとに明滅させる -->
                                            <DataTrigger Binding="{Binding IsTimeUp}" Value="True">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard x:Name="BlinkStoryboard">
                                                        <Storyboard RepeatBehavior="Forever">
                                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity"
                                                                                           Duration="0:0:1">
                                                                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                                                <DiscreteDoubleKeyFrame KeyTime="0:0:0.5" Value="0.15" />
                                                            </DoubleAnimationUsingKeyFrames>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <RemoveStoryboard BeginStoryboardName="BlinkStoryboard" />
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- 経過時間（アラームでは鳴る時刻、カウントアップでは「カウントアップ中」）。
                                 TimeUp 中は代わりに解除方法を、止めたカウントアップでは閉じ方を案内する -->
                            <Grid HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsTimeUp}" Value="True">
                                                    <Setter Property="Visibility" Value="Hidden" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsStopped}" Value="True">
                                                    <Setter Property="Visibility" Value="Hidden" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <!-- アラームでは右クリックメニューと同じベルを添える -->
                                    <TextBlock Text="&#xEA8F;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                               VerticalAlignment="Center" Margin="0,1,4,0"
                                               Foreground="{StaticResource SubTextBrush}"
                                               Visibility="{Binding IsAlarm, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock Text="{Binding SubText}" FontSize="10.5"
                                               Foreground="{StaticResource SubTextBrush}" />
                                </StackPanel>
                                <TextBlock Text="♪ クリックで止める" FontSize="10.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource WarningBrush}" HorizontalAlignment="Center"
                                           Visibility="{Binding IsTimeUp, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="■ 停止中 ・ クリックで閉じる" FontSize="10.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource AccentBrightBrush}" HorizontalAlignment="Center"
                                           Visibility="{Binding IsStopped, Converter={StaticResource BoolToVisibility}}" />
                            </Grid>

                            <!-- カウントダウンは残り割合を表示する（時間が経つと右から減っていく）。
                                 カウントアップは今の1分の経過割合（左から伸び、1分ごとに満ちて空に戻る）。
                                 残り時間と同じくらい目に入るよう太くし、光彩を付ける -->
                            <ProgressBar Height="12" Margin="16,6,16,0">
                                <ProgressBar.Style>
                                    <Style TargetType="ProgressBar" BasedOn="{StaticResource TimerProgressBarStyle}">
                                        <Setter Property="Value"
                                                Value="{Binding Progress, Mode=OneWay, Converter={StaticResource RemainingRatioConverter}}" />
                                        <Setter Property="Effect" Value="{StaticResource BarTealGlowEffect}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCountUp}" Value="True">
                                                <Setter Property="Value" Value="{Binding MinuteProgress, Mode=OneWay}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource ProgressWarningFillBrush}" />
                                                <Setter Property="Effect" Value="{StaticResource BarPinkGlowEffect}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ProgressBar.Style>
                            </ProgressBar>
                        </StackPanel>

                        <!-- 長押し中の円形ゲージ。少し押し続けると現れ、真上から時計回りに伸びて
                             一周したらキャンセル（カウントアップの計測中は停止）。
                             カウントダウンのキャンセルはピンクに ✕、カウントアップの停止はティールに ■。
                             現れるまでは Opacity=0（コードビハインドのアニメーションで表示する） -->
                        <Grid x:Name="HoldOverlay" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
                            <Border Background="#F01D2326" CornerRadius="0,0,3,3" />
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <!-- ゲージとアイコンの色。Tag に入れて子から参照する -->
                                        <Setter Property="Tag" Value="{StaticResource WarningBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCountingUp}" Value="True">
                                                <Setter Property="Tag" Value="{StaticResource AccentBrightBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <!-- 下地の輪と、伸びていく弧（端は丸めず直線で切る） -->
                                <Ellipse Width="56" Height="56" Stroke="{StaticResource ProgressTrackBrush}" StrokeThickness="7" />
                                <v:ProgressArc x:Name="HoldGauge" Width="56" Height="56" StrokeThickness="7"
                                               StrokeStartLineCap="Flat" StrokeEndLineCap="Flat"
                                               Stroke="{Binding Tag, RelativeSource={RelativeSource AncestorType=Grid}}">
                                    <v:ProgressArc.Style>
                                        <Style TargetType="v:ProgressArc">
                                            <Setter Property="Effect" Value="{StaticResource PinkGlowEffect}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCountingUp}" Value="True">
                                                    <Setter Property="Effect" Value="{StaticResource TealGlowEffect}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </v:ProgressArc.Style>
                                </v:ProgressArc>
                                <TextBlock FontFamily="{StaticResource IconFont}" FontSize="17"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{Binding Tag, RelativeSource={RelativeSource AncestorType=Grid}}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="&#xE711;" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCountingUp}" Value="True">
                                                    <Setter Property="Text" Value="&#xE71A;" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Viewbox>

        <!-- 右下のリサイズハンドル。Viewbox の外に置き、スケールに関係なく同じ大きさで表示する -->
        <Thumb Style="{StaticResource ResizeHandleStyle}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
               DragStarted="ResizeHandle_DragStarted" DragDelta="ResizeHandle_DragDelta" />
    </Grid>
</Window>
