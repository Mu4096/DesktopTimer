<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:v="clr-namespace:DesktopTimer.Views">

    <!-- タイマーウィンドウ（デスクトップに常駐する本体）のスタイル -->

    <v:LabelPartConverter x:Key="LabelPartConverter" />
    <v:RemainingRatioConverter x:Key="RemainingRatioConverter" />

    <!-- 本体の背景。上をわずかに明るくして、板が浮いているように見せる -->
    <LinearGradientBrush x:Key="TimerCardBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FF283034" />
        <GradientStop Offset="1" Color="#FF1A1F22" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="TimerCardStrokeBrush" Color="#4D39C5BB" />
    <SolidColorBrush x:Key="TimerCardWarningStrokeBrush" Color="#80FF5AA5" />

    <!-- 上端の光るライン（ツインテールのように両端へ向かって消える） -->
    <LinearGradientBrush x:Key="TimerAccentLineBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="#0039C5BB" />
        <GradientStop Offset="0.5" Color="#FF4FD8CC" />
        <GradientStop Offset="1" Color="#0039C5BB" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="TimerAccentLineWarningBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="#00FF5AA5" />
        <GradientStop Offset="0.5" Color="#FFFF5AA5" />
        <GradientStop Offset="1" Color="#00FF5AA5" />
    </LinearGradientBrush>

    <!-- 進捗バーの塗り（先端ほど明るい）と下地 -->
    <LinearGradientBrush x:Key="ProgressFillBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="#FF22A69C" />
        <GradientStop Offset="1" Color="#FF5CE3D6" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ProgressWarningFillBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="#FFE0307F" />
        <GradientStop Offset="1" Color="#FFFF7DB8" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ProgressTrackBrush" Color="#FF2B3539" />

    <!-- 残り時間の文字の光彩 -->
    <DropShadowEffect x:Key="TealGlowEffect" Color="#FF39C5BB" BlurRadius="14" ShadowDepth="0" Opacity="0.55" />
    <DropShadowEffect x:Key="PinkGlowEffect" Color="#FFFF5AA5" BlurRadius="16" ShadowDepth="0" Opacity="0.7" />
    <!-- 進捗バーの光彩（文字より控えめ） -->
    <DropShadowEffect x:Key="BarTealGlowEffect" Color="#FF39C5BB" BlurRadius="10" ShadowDepth="0" Opacity="0.45" />
    <DropShadowEffect x:Key="BarPinkGlowEffect" Color="#FFFF5AA5" BlurRadius="10" ShadowDepth="0" Opacity="0.55" />

    <!-- 右下のリサイズハンドル。ウィンドウにマウスが乗っている間（とドラッグ中）だけ表示する -->
    <Style x:Key="ResizeHandleStyle" TargetType="Thumb">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Cursor" Value="SizeNWSE" />
        <Setter Property="Opacity" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <!-- 透明の背景で当たり判定を確保し、斜めに並べた点で「つまめる」ことを示す -->
                    <Grid Background="Transparent">
                        <Path x:Name="Dots" Fill="{StaticResource AccentBrush}" Opacity="0.7"
                              HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,4">
                            <Path.Data>
                                <GeometryGroup>
                                    <RectangleGeometry Rect="7,1,2,2" />
                                    <RectangleGeometry Rect="4,4,2,2" />
                                    <RectangleGeometry Rect="7,4,2,2" />
                                    <RectangleGeometry Rect="1,7,2,2" />
                                    <RectangleGeometry Rect="4,7,2,2" />
                                    <RectangleGeometry Rect="7,7,2,2" />
                                </GeometryGroup>
                            </Path.Data>
                        </Path>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Dots" Property="Opacity" Value="1" />
                            <Setter TargetName="Dots" Property="Fill" Value="{StaticResource AccentBrightBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                <Setter Property="Opacity" Value="1" />
            </DataTrigger>
            <Trigger Property="IsDragging" Value="True">
                <Setter Property="Opacity" Value="1" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--
        プリセットボタン（Idle の主役）。動作中の画面と同じく、暗い板に白い数字＋ティールの光彩で表示し、
        下端のティールのラインでボタンであることを示す。数字を大きく、単位を小さく表示する
    -->
    <Style x:Key="PresetButtonStyle" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <!-- フォーカス枠を出さない。キーボード操作はホットキーで行う -->
        <Setter Property="Focusable" Value="False" />
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <!-- 数字だけをボタンの中央に置き、単位は数字の右にくっつける（左右の * 列を同じ幅にして中央を決める） -->
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Converter={StaticResource LabelPartConverter}, ConverterParameter=Number}"
                                   FontFamily="{StaticResource DigitFont}" FontSize="38" FontWeight="SemiBold"
                                   Effect="{StaticResource TealGlowEffect}" VerticalAlignment="Bottom" />
                        <TextBlock Grid.Column="2"
                                   Text="{Binding Converter={StaticResource LabelPartConverter}, ConverterParameter=Unit}"
                                   FontFamily="Yu Gothic UI" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentBrightBrush}"
                                   HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="3,0,0,8" />
                    </Grid>
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
                        <!-- ホバー時の光彩（ぼかした板を後ろに敷く） -->
                        <Border x:Name="Glow" CornerRadius="3" Background="{StaticResource AccentBrush}" Opacity="0">
                            <Border.Effect>
                                <BlurEffect Radius="10" />
                            </Border.Effect>
                        </Border>
                        <Border x:Name="Bd" CornerRadius="3" Background="{TemplateBinding Background}" />
                        <!-- ホバー・押下時にティールをうっすら重ねる -->
                        <Border x:Name="Tint" CornerRadius="3" Background="{StaticResource AccentFaintBrush}" Opacity="0" />
                        <!-- 下端のティールのライン -->
                        <Border x:Name="Line" CornerRadius="0,0,3,3" Height="2.5" VerticalAlignment="Bottom"
                                Background="{StaticResource AccentBrush}" />
                        <ContentPresenter Margin="0,0,0,2" HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Tint" Property="Opacity" Value="1" />
                            <Setter TargetName="Line" Property="Background" Value="{StaticResource AccentBrightBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity"
                                                         To="0.35" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Tint" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                            <!-- 押した時に少し縮める -->
                            <Setter TargetName="Root" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.96" ScaleY="0.96" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- グリップ上のアイコンボタン（⚙）。グリップと同じく控えめに常時表示し、ホバーでティールにする -->
    <Style x:Key="GripIconButtonStyle" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="9" />
        <Setter Property="Width" Value="24" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="0,4,0,0">
                        <ContentPresenter Margin="0,1,2,0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource AccentBrightBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        進捗バー（残り割合。時間が経つと右から減っていく）。音量メーターのように細かい区切りを入れる。
        区切りは OpacityMask のタイル（幅5の目盛り＋隙間2、高さ12）で、下地と塗りの両方に掛ける
    -->
    <Style x:Key="TimerProgressBarStyle" TargetType="ProgressBar">
        <Setter Property="Background" Value="{StaticResource ProgressTrackBrush}" />
        <Setter Property="Foreground" Value="{StaticResource ProgressFillBrush}" />
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Grid.OpacityMask>
                            <DrawingBrush TileMode="Tile" Stretch="None"
                                          Viewport="0,0,7,12" ViewportUnits="Absolute"
                                          Viewbox="0,0,7,12" ViewboxUnits="Absolute">
                                <DrawingBrush.Drawing>
                                    <DrawingGroup>
                                        <!-- タイルの大きさを 7×12 に固定するための透明な四角 -->
                                        <GeometryDrawing Brush="Transparent">
                                            <GeometryDrawing.Geometry>
                                                <RectangleGeometry Rect="0,0,7,12" />
                                            </GeometryDrawing.Geometry>
                                        </GeometryDrawing>
                                        <GeometryDrawing Brush="Black">
                                            <GeometryDrawing.Geometry>
                                                <RectangleGeometry Rect="0,0,5,12" RadiusX="1" RadiusY="1" />
                                            </GeometryDrawing.Geometry>
                                        </GeometryDrawing>
                                    </DrawingGroup>
                                </DrawingBrush.Drawing>
                            </DrawingBrush>
                        </Grid.OpacityMask>
                        <Border x:Name="PART_Track" Background="{TemplateBinding Background}" />
                        <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
